{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-openspec",
    "opencode-anthropic-auth",
    "@ex-machina/opencode-anthropic-auth"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["chrome-devtools-mcp"]
    }
  },
  "agent": {
    "build": {
      "permission": {
        "external_directory": {
          "/tmp/chrome-devtools-mcp-*": "allow"
        }
      }
    }
  }
}
